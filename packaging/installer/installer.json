  "startMenuShortcut": true,
  "uninstallEntry": true,
  "preserveUserDataOnUninstall": true,
  "projectFileRegistration": false,
  "authoringTool": "GraphReader.Installer",
  "upgradePolicy": "allow-newer-and-repair-same",
  "downgradePolicy": "blocked-by-default",
