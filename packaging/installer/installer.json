{
  "schemaVersion": 2,
  "kind": "installer",
  "format": "setup-exe",
  "architecture": "x64",
  "scope": "perUser",
  "requiresAdministrator": false,
  "offlineCoreWorkflow": true,
  "commonPublishOnly": true,
  "mutableDataRoot": "%LOCALAPPDATA%\\GraphAutoReader",
