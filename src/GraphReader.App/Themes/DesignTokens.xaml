<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <FontFamily x:Key="App.FontFamily.Default">../Assets/Fonts/#Noto Sans</FontFamily>

  <sys:Double x:Key="App.FontSize.Caption">12</sys:Double>
  <sys:Double x:Key="App.FontSize.Body">14</sys:Double>
  <sys:Double x:Key="App.FontSize.Subtitle">18</sys:Double>
  <sys:Double x:Key="App.FontSize.Title">24</sys:Double>
  <sys:Double x:Key="App.LineHeight.Caption">16</sys:Double>
  <sys:Double x:Key="App.LineHeight.Body">20</sys:Double>
  <sys:Double x:Key="App.LineHeight.Subtitle">24</sys:Double>
  <sys:Double x:Key="App.LineHeight.Title">32</sys:Double>

  <sys:Double x:Key="App.Spacing.2">2</sys:Double>
  <sys:Double x:Key="App.Spacing.4">4</sys:Double>
  <sys:Double x:Key="App.Spacing.8">8</sys:Double>
  <sys:Double x:Key="App.Spacing.12">12</sys:Double>
  <sys:Double x:Key="App.Spacing.16">16</sys:Double>
  <sys:Double x:Key="App.Spacing.24">24</sys:Double>
  <sys:Double x:Key="App.Spacing.32">32</sys:Double>

  <sys:Double x:Key="App.Control.Height">36</sys:Double>
  <Thickness x:Key="App.Control.BorderWidth">1</Thickness>

  <CornerRadius x:Key="App.CornerRadius.Small">3</CornerRadius>
  <CornerRadius x:Key="App.CornerRadius.Medium">6</CornerRadius>
  <CornerRadius x:Key="App.CornerRadius.Large">10</CornerRadius>

  <Thickness x:Key="App.Thickness.ControlPadding">12,6</Thickness>
  <Thickness x:Key="App.Thickness.CompactPadding">8,4</Thickness>
  <Thickness x:Key="App.Thickness.Focus">2</Thickness>

  <sys:Boolean x:Key="App.Motion.Enabled">True</sys:Boolean>
  <Duration x:Key="App.Motion.Duration.Short">0:0:0.14</Duration>
</ResourceDictionary>
