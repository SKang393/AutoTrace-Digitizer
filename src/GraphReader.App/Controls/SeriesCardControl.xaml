<UserControl x:Class="GraphReader.App.Controls.SeriesCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             IsTabStop="False"
             AutomationProperties.Name="{Binding AccessibleSymbolName, ElementName=Root}">
  <Border Padding="12"
          Style="{DynamicResource App.Style.Card}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="38" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Width="32"
                Height="32"
                HorizontalAlignment="Left"
                Background="{DynamicResource App.Brush.Surface}"
                BorderBrush="{DynamicResource App.Brush.Text}"
                BorderThickness="1"
                CornerRadius="{DynamicResource App.CornerRadius.Small}"
                AutomationProperties.Name="{Binding AccessibleSymbolName, ElementName=Root}">
          <TextBlock HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Text="{Binding SymbolGlyph, ElementName=Root}" />
        </Border>

        <StackPanel Grid.Column="1" Margin="8,0">
          <TextBlock FontWeight="SemiBold"
                     Text="{Binding InferredLabel, ElementName=Root}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Margin="0,2,0,0"
                     FontSize="{DynamicResource App.FontSize.Caption}"
                     Foreground="{DynamicResource App.Brush.TextMuted}"
                     Text="{Binding AccessibleSymbolName, ElementName=Root}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <ToggleButton Grid.Column="2"
                      MinWidth="32"
                      Padding="6,3"
                      VerticalAlignment="Center"
                      IsChecked="{Binding IsSeriesVisible, ElementName=Root, Mode=TwoWay}"
                      Style="{DynamicResource App.Style.ToggleButton}"
                      ToolTip="{DynamicResource SeriesCard.Visibility}"
                      AutomationProperties.Name="{DynamicResource SeriesCard.Visibility}">
          <TextBlock FontSize="{DynamicResource App.FontSize.Caption}" Text="{DynamicResource SeriesCard.Visibility}" />
        </ToggleButton>
      </Grid>

      <Grid Grid.Row="1" Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,6,0">
          <TextBlock FontSize="{DynamicResource App.FontSize.Caption}" Foreground="{DynamicResource App.Brush.TextMuted}" Text="{DynamicResource SeriesCard.MarkerCount}" />
          <Border Margin="0,2,0,0"
                  HorizontalAlignment="Left"
                  Padding="6,1"
                  Background="{DynamicResource App.Brush.PrimarySubtle}"
                  CornerRadius="8">
            <TextBlock Text="{Binding MarkerCount, ElementName=Root}"
                       AutomationProperties.Name="{DynamicResource SeriesCard.MarkerCount}" />
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="6,0,0,0">
          <TextBlock FontSize="{DynamicResource App.FontSize.Caption}" Foreground="{DynamicResource App.Brush.TextMuted}" Text="{DynamicResource SeriesCard.Confidence}" />
          <TextBlock x:Name="ConfidenceText" Margin="0,2,0,0" FontWeight="SemiBold" AutomationProperties.Name="{DynamicResource SeriesCard.Confidence}" />
        </StackPanel>
      </Grid>

      <UniformGrid Grid.Row="2" Margin="0,10,0,0" Columns="2">
        <Button Margin="0,0,4,0"
                Padding="8,4"
                Style="{DynamicResource App.Style.Button}"
                Command="{Binding SelectCommand, ElementName=Root}"
                CommandParameter="{Binding CommandParameter, ElementName=Root}"
                AutomationProperties.Name="{DynamicResource SeriesCard.Select}"
                Content="{DynamicResource SeriesCard.Select}" />
        <Button Margin="4,0,0,0"
                Padding="8,4"
                Style="{DynamicResource App.Style.SubtleButton}"
                Command="{Binding ReassignCommand, ElementName=Root}"
                CommandParameter="{Binding CommandParameter, ElementName=Root}"
                AutomationProperties.Name="{DynamicResource SeriesCard.Reassign}"
                Content="{DynamicResource SeriesCard.Reassign}" />
      </UniformGrid>
    </Grid>
  </Border>
</UserControl>
